#version 450

#include "types.glsl"
#include "unary_elementwise_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint i = get_idx();

    if (i >= p.ne) {
        return;
    }

    const float x = float(data_a[unary_load_idx(i)]);
    const float result = (x > 20.0f) ? x : log(1.0f + exp(x));
    data_d[unary_store_idx(i)] = D_TYPE(result);
}
